+/*
+ * SPDX-License-Identifier: MIT
+ * XeGfx (Darwin): drmIoctl() hands every request here first; nonzero means it was answered and *ret holds the
+ * result. See xf86drm_xegfx.c.
+ * <wtl> project: xegfx | author: watchthelight </wtl>
+ */
+#ifndef XF86DRM_XEGFX_H
+#define XF86DRM_XEGFX_H
+#ifdef __APPLE__
+int drmXeGfxIoctl(int fd, unsigned long request, void *arg, int *ret);
+#endif
+#endif
